# Copy this file to .env and fill in the secret values before running the app.
# Do NOT commit your .env to a public repository.

# App
APP_NAME="OtoStop Global+"            # display name for emails, UI, etc.
APP_URL=http://localhost:3000          # public URL of the app (used in emails)

# Environment
NODE_ENV=development

# Database
# For example: mysql://user:pass@host:3306/dbname
DATABASE_URL=

# JWT
JWT_SECRET=replace-with-a-secure-random-secret

# Mail (no-reply)
MAIL_NOREPLY_HOST=box.srv1079156.hstgr.cloud
MAIL_NOREPLY_PORT=465
MAIL_NOREPLY_USER=no-reply@otostop.kassigroup.com
MAIL_NOREPLY_PASS=

# Mail (contact)
MAIL_CONTACT_HOST=box.srv1079156.hstgr.cloud
MAIL_CONTACT_PORT=465
MAIL_CONTACT_USER=contact@otostop.kassigroup.com
MAIL_CONTACT_PASS=

# Optional: other provider credentials or flags used by the app
# e.g. SENTRY_DSN=, NEXTAUTH_URL=, THIRD_PARTY_KEY=
